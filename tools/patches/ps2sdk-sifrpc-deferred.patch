 /* Command 0x80000008 */
+extern SifRpcClientData_t _fio_cd;
+
+static int _rpc_client_ptr_ok(const void *ptr)
+{
+    unsigned int p = (unsigned int)ptr;
+
+    return p >= 0x00100000u && p < 0x02000000u && (p & 3u) == 0;
+}
+
+static int _rpc_packet_ptr_ok(const void *ptr)
+{
+    unsigned int p = (unsigned int)ptr;
+    unsigned int base = (unsigned int)_sif_rpc_data.pkt_table;
+
+    if (base == 0 || _sif_rpc_data.pkt_table_len <= 0)
+        return 0;
+
+    if (p < base || p >= base + (unsigned int)_sif_rpc_data.pkt_table_len * RPC_PACKET_SIZE)
+        return 0;
+
+    return ((p - base) & (RPC_PACKET_SIZE - 1)) == 0;
+}
+
+static void _rpc_dump_client(const char *name, const SifRpcClientData_t *cd)
+{
+    if (!_rpc_client_ptr_ok(cd)) {
+        printf("[sifrpc] client %s: invalid pointer %08x\n", name, (unsigned int)cd);
+        return;
+    }
+
+    printf("[sifrpc] client %s @ %08x: pkt=%08x rpc=%08x sema=%d cmd=%08x "
+           "server=%08x buf=%08x cbuf=%08x end=%08x param=%08x\n",
+        name, (unsigned int)cd, (unsigned int)cd->hdr.pkt_addr,
+        (unsigned int)cd->hdr.rpc_id, (int)cd->hdr.sema_id,
+        (unsigned int)cd->command, (unsigned int)cd->server,
+        (unsigned int)cd->buf, (unsigned int)cd->cbuf,
+        (unsigned int)cd->end_function, (unsigned int)cd->end_param);
+}
+
+#define RPC_INVALID_DUMP_WORDS 16
+
+static void _rpc_dump_invalid_completion(SifRpcRendPkt_t *request);
+
+static volatile u32 _rpc_invalid_dump_count;
+static u32 _rpc_invalid_dump_words[RPC_INVALID_DUMP_WORDS];
+
+static void _rpc_record_invalid_completion(SifRpcRendPkt_t *request)
+{
+    const u32 *w = (const u32 *)request;
+    int i;
+
+    for (i = 0; i < RPC_INVALID_DUMP_WORDS; i++)
+        _rpc_invalid_dump_words[i] = w[i];
+
+    __asm__ volatile("" ::: "memory");
+    _rpc_invalid_dump_count++;
+}
+
+/* Prints the most recent invalid completion. Called from thread context
+ * because printf is not safe inside the SIF command handler: it takes the
+ * stdio lock and can deadlock if the interrupted thread already owns it. */
+void sceSifRpcDumpInvalidCompletion(void)
+{
+    u32 snapshot_words[RPC_INVALID_DUMP_WORDS];
+    u32 count = _rpc_invalid_dump_count;
+    int i;
+
+    if (count == 0)
+        return;
+
+    _rpc_invalid_dump_count = 0;
+    for (i = 0; i < RPC_INVALID_DUMP_WORDS; i++)
+        snapshot_words[i] = _rpc_invalid_dump_words[i];
+
+    printf("[sifrpc] deferred invalid completion count=%u\n", (unsigned int)count);
+    _rpc_dump_invalid_completion((SifRpcRendPkt_t *)snapshot_words);
+}
+
+static void _rpc_dump_invalid_completion(SifRpcRendPkt_t *request)
+{
+    const u32 *w = (const u32 *)request;
+    int i;
+
+    printf("[sifrpc] !!! INVALID RPC completion: request=%08x cd=%08x "
+           "(guard: no dereference)\n",
+        (unsigned int)request, (unsigned int)request->cd);
+    printf("[sifrpc] fields: cid=%08x rec_id=%08x pkt_addr=%08x rpc_id=%08x "
+           "sd=%08x buf=%08x cbuf=%08x\n",
+        (unsigned int)request->cid, (unsigned int)request->rec_id,
+        (unsigned int)request->pkt_addr, (unsigned int)request->rpc_id,
+        (unsigned int)request->sd, (unsigned int)request->buf,
+        (unsigned int)request->cbuf);
+
+    for (i = 0; i < 16; i += 4) {
+        printf("[sifrpc] words %02x: %08x %08x %08x %08x\n", i * 4,
+            (unsigned int)w[i], (unsigned int)w[i + 1],
+            (unsigned int)w[i + 2], (unsigned int)w[i + 3]);
+    }
+
+    _rpc_dump_client("_fio_cd", &_fio_cd);
+
+    printf("[sifrpc] rdata_table idx=%d len=%d table=%08x\n",
+        _sif_rpc_data.rdata_table_idx, _sif_rpc_data.rdata_table_len,
+        (unsigned int)_sif_rpc_data.rdata_table);
+    if (_sif_rpc_data.rdata_table != NULL) {
+        const u32 *r = (const u32 *)_sif_rpc_data.rdata_table;
+
+        for (i = 0; i < _sif_rpc_data.rdata_table_len; i++, r += 16) {
+            if (r[4] == 0 && r[5] == 0 && r[6] == 0 && r[8] == 0)
+                continue;
+
+            printf("[sifrpc] rdata[%02d]: rec_id=%08x pkt_addr=%08x rpc_id=%08x "
+                   "cd=%08x cid=%08x sd=%08x buf=%08x cbuf=%08x\n",
+                i, (unsigned int)r[4], (unsigned int)r[5],
+                (unsigned int)r[6], (unsigned int)r[7], (unsigned int)r[8],
+                (unsigned int)r[9], (unsigned int)r[10], (unsigned int)r[11]);
+        }
+    }
+
+    printf("[sifrpc] pkt_table len=%d table=%08x\n",
+        _sif_rpc_data.pkt_table_len, (unsigned int)_sif_rpc_data.pkt_table);
+    if (_sif_rpc_data.pkt_table != NULL) {
+        const u32 *p = (const u32 *)_sif_rpc_data.pkt_table;
+
+        for (i = 0; i < _sif_rpc_data.pkt_table_len; i++, p += 16) {
+            if (!(p[4] & PACKET_F_ALLOC))
+                continue;
+
+            printf("[sifrpc] pkt[%02d]: rec_id=%08x pkt_addr=%08x rpc_id=%08x "
+                   "cd=%08x cid=%08x sd=%08x\n",
+                i, (unsigned int)p[4], (unsigned int)p[5],
+                (unsigned int)p[6], (unsigned int)p[7], (unsigned int)p[8],
+                (unsigned int)p[9]);
+        }
+    }
+}
